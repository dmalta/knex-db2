{
  "name": "knex-db2",
  "version": "0.1.0",
  "description": "A Knex.js client for IBM Db2 for z/OS",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPatterns=unit",
    "test:integration": "jest --testPathPatterns=integration",
    "test:real": "DB2_REAL_TEST=true jest --testPathPatterns=integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.js",
    "format:check": "prettier --check src/**/*.js"
  },
  "keywords": [
    "knex",
    "db2",
    "zos",
    "database",
    "sql",
    "query-builder"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ibm_db": "3.3.2",
    "knex": "^2.0.0 || ^3.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "knex": "^2.0.0 || ^3.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
