{
  "name": "@dmalta/knex-db2",
  "version": "1.0.1",
  "description": "A Knex.js client for IBM Db2 for z/OS",
  "main": "src/index.js",
  "files": [
    "src/client.js",
    "src/db2-errors.js",
    "src/index.js",
    "src/query/",
    "src/schema/",
    "config/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmalta/knex-db2.git"
  },
  "bugs": {
    "url": "https://github.com/dmalta/knex-db2/issues"
  },
  "homepage": "https://github.com/dmalta/knex-db2#readme",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPatterns=unit",
    "test:integration": "jest --testPathPatterns=integration",
    "test:real": "DB2_REAL_TEST=true jest --testPathPatterns=integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.js",
    "format:check": "prettier --check src/**/*.js",
    "prepublishOnly": "npm run lint && npm run test"
  },
  "keywords": [
    "knex",
    "db2",
    "zos",
    "database",
    "sql",
    "query-builder"
  ],
  "author": "dmalta",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "ibm_db": "^3.3.2",
    "jest": "^30.1.3",
    "knex": "^3.1.0",
    "prettier": "^3.6.2"
  },
  "peerDependencies": {
    "ibm_db": "3.3.2",
    "knex": "^3.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
